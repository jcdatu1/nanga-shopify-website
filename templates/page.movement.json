    "c_content_panel_zfKLGJ": {
      "type": "c-content-panel",
      "blocks": {
        "heading_qzN7Qw": {
          "type": "heading",
          "settings": {
            "title": "WATERPROOF & BREATHABLE: What Is NANGA's Original Material \"AURORA TEX®\"?"
          }
        },
        "text_mnBykx": {
          "type": "text",
          "settings": {
            "text": "<p>NANGA's original fabric, \"AURORA TEX®,\" offers excellent waterproofing with a water pressure resistance (*Note 1) of 20,000mm, reliably blocking even heavy rain. In addition, its moisture permeability (*Note 2) of 6,000g/m²/24hrs allows internal humidity to escape appropriately, reducing uncomfortable dampness and providing a dry, comfortable wearing experience.</p><p></p>"
          }
        },
        "text_jUFM8H": {
          "type": "text",
          "settings": {
            "text": "<p>*Note 1: A measurement of how much water pressure a fabric or material can withstand. As a general guide, light rain is about 500mm, moderate rain is about 2,000mm, and heavy rain is about 10,000mm.</p><p></p>"
          }
        },
        "text_xhCqcm": {
          "type": "text",
          "settings": {
            "text": "<p>*Note 2: A measurement of how many grams of moisture a fabric releases per square meter over 24 hours. AURORA TEX®'s moisture permeability value means it can release 6,000g of moisture per square meter over 24 hours.</p>"
          }
        }
      },
      "block_order": [
        "heading_qzN7Qw",
        "text_mnBykx",
        "text_jUFM8H",
        "text_xhCqcm"
      ],
