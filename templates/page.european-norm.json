          "settings": {
            "title": "NANGA uses the European Norm, the EU's unified standard for temperature ratings"
          }
        },
        "en_intro_text_1": {
          "type": "text",
          "settings": {
            "text": "<p>EN (European Norm), also called the European Standard, is the name for standards adopted across the EU. For sleeping bags, EN 13537 defines how temperature ratings are calculated.</p><p>Brands used to calculate temperature ratings with their own methods. EN ratings put every bag on the same scale. Testing is done by accredited third-party labs, which sets EN ratings apart from ratings based on a brand's own standards.</p>"
          }
        }
