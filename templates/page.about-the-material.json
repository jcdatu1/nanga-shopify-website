        "mat_feat_1": {
          "type": "text_block",
          "settings": {
            "enable_media": false,
            "title": "02. Shoulder Warmer",
            "text": "<p>An insulated tube around the shoulders keeps warm air from escaping. Used mainly on 3-season and colder sleeping bags.</p><p><em>Not included on synthetic-fill sleeping bags.</em></p>",
            "button_label": "",
            "link": ""
          }
        },
        "mat_feat_2": {
          "type": "text_block",
          "settings": {
            "enable_media": false,
            "title": "03. Draft Tube",
            "text": "<p>An insulated tube along the inside of the zipper blocks cold air from seeping through and boosts warmth. Like the shoulder warmer, it's used on 3-season and colder sleeping bags.</p><p><em>Not included on synthetic-fill sleeping bags.</em></p>",
            "button_label": "",
            "link": ""
          }
        },
        "mat_feat_3": {
          "type": "text_block",
          "settings": {
            "enable_media": false,
            "title": "04. Zipper",
            "text": "<p>We use YKK #5 coil zippers (5C), which YKK's own strength testing found best suited to sleeping bags.</p>",
            "button_label": "",
            "link": ""
          }
        },
        "mat_feat_4": {
