          "settings": {
            "enable_media": false,
            "title": "05. Size",
            "text": "<p>Our regular size is a roomy fit: up to 210 cm (82.7 in) long and 80 cm (31.5 in) wide at the shoulders. Long and short sizes are also available.</p>",
            "button_label": "",
            "link": ""
          }
