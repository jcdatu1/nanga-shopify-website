          "settings": {
            "enable_media": true,
            "title": "Trapezoid Quilt",
            "text": "<p>Angled boxes support one another so the down reaches its full loft. Less shifting means less heat loss, so you stay warm efficiently.</p>",
            "button_label": "",
            "link": "",
            "image": "shopify://shop_images/knowledge-quilt-trapezoid.png"
