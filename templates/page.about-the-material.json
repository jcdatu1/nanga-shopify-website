        },
        "mat_quilt_2": {
          "type": "text_block",
          "settings": {
            "enable_media": true,
            "title": "Differential Box Quilt",
            "text": "<p>The outer shell is cut larger than the lining, so the down can loft fully without being compressed as the bag wraps around you. This reduces cold spots and keeps warmth in.</p>",
            "button_label": "",
            "link": "",
            "image": "shopify://shop_images/knowledge-quilt-differential.png"
