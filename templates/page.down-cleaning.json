    "dc_intro": {
      "type": "c-content-panel",
      "blocks": {
        "dc_intro_text_0": {
          "type": "text",
          "settings": {
            "text": "<p>At NANGA, we believe true sustainability starts with knowing how to care for what you own. That's why, since 2020, we've been expanding our care and repair services.</p><p>To help you keep your down in top condition for as long as possible, we're also creating videos and products that make it easy to clean and maintain your gear yourself. As a first step, here's how to wash down jackets, vests, and sleeping bags at home.</p><p>If your down seems to have lost some of its loft, try the steps below.</p>"
          }
        },
        "dc_intro_text_1": {
          "type": "text",
          "settings": {
            "text": "<p><em>Like any laundering, washing can cause some wear to the fabric and down. Wash at your own risk.</em></p><p><em>Care labels vary by product, so check yours before washing.</em></p>"
          }
        }
      },
      "block_order": [
        "dc_intro_text_0",
        "dc_intro_text_1"
      ],
      "settings": {
        "background_color": "#ffffff",
        "text_color": "#000000",
